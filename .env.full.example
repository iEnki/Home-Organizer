# ============================================================
# Umzughelfer + Supabase — Vollständige Umgebungsvariablen
# Für den kompletten Self-Hosted Stack (docker-compose.full.yml)
#
# EMPFOHLEN: ./install.sh ausführen — generiert alle Secrets automatisch
# MANUELL:   Diese Datei als ".env" kopieren und alle Werte eintragen
# ============================================================

# ============================================================
# APP-EINSTELLUNGEN
# ============================================================

# Öffentliche URL der React-App (wichtig für Auth-Redirects)
SITE_URL=https://umzug.meine-domain.de

# Öffentliche URL der Supabase-API (Kong Gateway)
API_EXTERNAL_URL=https://supa.meine-domain.de
SUPABASE_PUBLIC_URL=https://supa.meine-domain.de

# Externer Port für die React-App (Nginx hört intern auf 80)
APP_PORT=3000

# Sourcemaps deaktivieren (empfohlen für Produktion)
GENERATE_SOURCEMAP=false

# ============================================================
# REACT-APP BUILD-VARIABLEN (werden zur Build-Zeit eingebettet)
# ============================================================

REACT_APP_SUPABASE_URL=https://supa.meine-domain.de
REACT_APP_SUPABASE_ANON_KEY=<anon-key-aus-generate-keys>
REACT_APP_PASSWORD_RESET_REDIRECT_URL=https://umzug.meine-domain.de/update-password
REACT_APP_VAPID_PUBLIC_KEY=<vapid-public-key-aus-generate-keys>

# ============================================================
# SUPABASE API-KEYS
# Generieren: node scripts/generate-keys.js
# ============================================================

# JWT-Token mit Rolle "anon" (öffentlich verwendbar)
ANON_KEY=<generiertes-jwt>

# JWT-Token mit Rolle "service_role" (NUR serverseitig verwenden!)
SERVICE_ROLE_KEY=<generiertes-jwt>

# ============================================================
# DATENBANK (PostgreSQL)
# ============================================================

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<stark-generiertes-passwort>

# ============================================================
# SICHERHEITSSCHLÜSSEL
# Alle via: node scripts/generate-keys.js
# ============================================================

JWT_SECRET=<min-32-zeichen-zufallsstring>
JWT_EXPIRY=3600

SECRET_KEY_BASE=<64-byte-hex-string>
VAULT_ENC_KEY=<32-zeichen-hex-string>
PG_META_CRYPTO_KEY=<32-zeichen-hex-string>

# ============================================================
# SUPABASE STUDIO (Admin-Oberfläche)
# ============================================================

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=<sicheres-passwort-min-8-zeichen>

STUDIO_DEFAULT_ORGANIZATION=Umzughelfer
STUDIO_DEFAULT_PROJECT=Umzughelfer

# ============================================================
# KONG API-GATEWAY PORTS
# ============================================================

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ============================================================
# ANALYTICS (Logflare)
# ============================================================

LOGFLARE_PUBLIC_ACCESS_TOKEN=<generiertes-token>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<generiertes-token>

# ============================================================
# STORAGE
# ============================================================

GLOBAL_S3_BUCKET=local
REGION=local
STORAGE_TENANT_ID=local
S3_PROTOCOL_ACCESS_KEY_ID=<generierter-key>
S3_PROTOCOL_ACCESS_KEY_SECRET=<generiertes-secret>

# ============================================================
# CONNECTION POOLER (Supavisor)
# ============================================================

POOLER_TENANT_ID=umzughelfer
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543

# ============================================================
# AUTH-EINSTELLUNGEN
# ============================================================

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ADDITIONAL_REDIRECT_URLS=

MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ============================================================
# SMTP (optional — für E-Mail-Bestätigungen)
# Ohne SMTP können sich Nutzer nicht per E-Mail verifizieren.
# Empfehlung: Mailgun, SendGrid, oder eigenen SMTP-Server nutzen.
# ============================================================

SMTP_ADMIN_EMAIL=admin@meine-domain.de
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Umzughelfer

# ============================================================
# PUSH NOTIFICATIONS (VAPID)
# Generieren: node scripts/generate-keys.js
# ============================================================

VAPID_SUBJECT=mailto:admin@meine-domain.de
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>

# ============================================================
# OLLAMA (optional — self-hosted LLM für KI-Assistenten)
#
# Option A — Ollama mit Docker mitinstallieren:
#   docker compose -f docker-compose.full.yml --profile ollama up -d
#   docker exec ollama ollama pull llama3.2
#   → Ollama-URL in der App: http://ollama:11434  (oder http://SERVER-IP:11434)
#
# Option B — Bestehenden Ollama-Server nutzen:
#   Kein Docker-Profil nötig. URL direkt in der App eintragen:
#   Profil → KI-Einstellungen → Ollama-URL (z.B. http://192.168.1.100:11434)
# ============================================================

# Port für Ollama-API (nur relevant bei Option A / Docker-Installation)
OLLAMA_PORT=11434

# URL eines externen Ollama-Servers (nur für Dokumentation — wird in der App eingetragen)
# OLLAMA_EXTERNAL_URL=http://192.168.1.100:11434

# ============================================================
# EDGE FUNCTIONS
# ============================================================

# JWT-Verifikation für Edge Functions (true = sicher, false = offen)
FUNCTIONS_VERIFY_JWT=true

# Haushalts-Einladungsmails (optional, send-household-invite via Resend)
# Nur nötig, wenn Einladungen direkt per E-Mail versendet werden sollen.
RESEND_API_KEY=
INVITE_FROM_EMAIL=
INVITE_BRAND_NAME=Umzughelfer

# Kochbuch Parser/Transkriptions-Service
# Muss lang und zufaellig sein; wird zwischen Edge Functions und Parser-Service geteilt.
RECIPE_PARSER_INTERNAL_TOKEN=<langer-zufalls-token>
RECIPE_PARSER_URL=http://recipe-source-parser:8090
RECIPE_PARSER_PORT=8090
WHISPER_DEVICE=auto
WHISPER_MODEL=small
WHISPER_CPU_COMPUTE_TYPE=int8
WHISPER_GPU_COMPUTE_TYPE=float16
WHISPER_CPP_FALLBACK_ENABLED=true

# Dokument OCR Service fuer gescannte PDF-Rechnungen
# Muss lang und zufaellig sein; wird zwischen Edge Functions und OCR-Service geteilt.
DOCUMENT_OCR_INTERNAL_TOKEN=<langer-zufalls-token>
DOCUMENT_OCR_URL=http://document-ocr-service:8091

# ============================================================
# POSTGREST-EINSTELLUNGEN
# ============================================================

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# ============================================================
# SONSTIGE DIENSTE
# ============================================================

IMGPROXY_ENABLE_WEBP_DETECTION=true
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
